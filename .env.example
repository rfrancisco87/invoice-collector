# Copy to .env.local and fill in. Never commit .env.local.
# See README.md for what each variable does and what breaks without it.

# ============================================================
# Required
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to a browser,
# never commit, rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie. Generate with: openssl rand -hex 32
APP_SESSION_SECRET=

# Public base URL. OAuth callbacks and email links are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials (OAuth 2.0 Client ID).
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Required for the features that use them
# ============================================================

# Encrypts users' LLM API keys at rest. Generate with: openssl rand -hex 32
# Changing this makes every stored key unreadable — back it up.
ENCRYPTION_KEY=

# Resend → API Keys. Used for invites, password resets and notifications.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or mail fails silently.
EMAIL_FROM=noreply@yourdomain.com

# Resend → Webhooks → signing secret (whsec_...).
# This signature is the ONLY authentication on /api/inbound-email.
# Unset means that route rejects everything — deliberate.
RESEND_WEBHOOK_SECRET=

# Bearer token protecting /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# ============================================================
# Optional
# ============================================================

# Only used when reprocessing a document through the webhook.
GOOGLE_REDIRECT_URI=

# Read only by scripts/backfill-webhook-url.ts. The app does not fall back
# to a shared webhook — each user configures their own endpoint or API key.
WEBHOOK_URL=

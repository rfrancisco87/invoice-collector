# ===================================
# CRITICAL: ENVIRONMENT VARIABLES
# ===================================
# NEVER COMMIT API KEYS OR SECRETS
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep these for reference (no secrets)
# !.env.example

# ===================================
# DEPENDENCIES
# ===================================
/node_modules
/.pnp
.pnp.js

# ===================================
# TESTING
# ===================================
/coverage

# ===================================
# NEXT.JS
# ===================================
/.next/
/out/
.swc/

# ===================================
# PRODUCTION
# ===================================
/build

# supabase/, scripts/ and docs/ are source, not build output — they were
# ignored here, which silently kept migrations 016-022, every maintenance
# script and the technical documentation out of the repository. The schema
# could not be rebuilt from a clone.
# Only the Supabase CLI's local state is genuinely disposable:
supabase/.temp
supabase/.branches


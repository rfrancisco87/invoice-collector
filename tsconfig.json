{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/ holds standalone CommonJS maintenance utilities run via `npx tsx`.
  // They are not part of the Next build, and because they use `require` without
  // module syntax TypeScript treats them as one shared global scope, so every
  // shared identifier collides. Excluding them keeps `npm run type-check`
  // meaningful for application code.
  "exclude": ["node_modules", "scripts"]
}
